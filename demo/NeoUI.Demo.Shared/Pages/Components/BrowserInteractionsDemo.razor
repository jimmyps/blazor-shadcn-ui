@page "/components/browser-interactions"
@implements IAsyncDisposable
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject IJSRuntime JS

<PageTitle>Interaction Mode - NeoUI</PageTitle>
<link rel="stylesheet" href="_content/NeoUI.Demo.Shared/css/browser-interactions.css" />

<div class="space-y-8 max-w-4xl" data-browser-interactions-demo @ref="pageRoot">
    <DemoPageHeader Title="Interaction Mode"
                    Description="Keep floating UI and typed input responsive with browser-local interactions and asynchronous application callbacks.">
        <div class="flex flex-wrap gap-2 text-xs text-muted-foreground">
            <span class="rounded-md border px-2 py-1">Preview</span>
            <span class="rounded-md border px-2 py-1">Opt-in mode</span>
            <span class="rounded-md border px-2 py-1">Keyboard accessible</span>
        </div>
    </DemoPageHeader>
    <section class="grid gap-4 sm:grid-cols-3 rounded-lg border bg-card text-card-foreground p-4 [&>div]:space-y-1" aria-label="Live demo activity">
        <div><span class="block text-xs font-medium text-muted-foreground">LOCAL UI EVENTS</span><strong class="block text-2xl font-semibold" data-local-events></strong><span class="block text-xs text-muted-foreground">Observed directly in this browser</span></div>
        <div><span class="block text-xs font-medium text-muted-foreground">LAST REVEAL</span><strong class="block text-2xl font-semibold" data-reveal-time></strong><span class="block text-xs text-muted-foreground">Input → positioned floating layer</span></div>
        <div><span class="block text-xs font-medium text-muted-foreground">APPLICATION CALLBACKS</span><strong class="block text-2xl font-semibold" data-testid="callback-count">@callbackCount</strong><span class="block text-xs text-muted-foreground">@pendingCallbacks pending · @parentRenders parent renders</span></div>
    </section>

    <DemoSection Title="Dropdown menus" Description="Compare browser-local opening, focus, submenus, and dismissal with the default Blazor interaction mode. On Interactive Server, the default path includes a server round trip.">
        <DemoBlock>
        <div class="grid gap-6 lg:grid-cols-2">
            <article class="space-y-4 min-w-0">
                <div class="flex flex-wrap items-center justify-between gap-2"><span class="rounded-md border px-2 py-1 text-xs font-medium bg-primary text-primary-foreground">BROWSER MODE</span><span class="text-xs text-muted-foreground">Click → browser → visible</span></div>
                <h3 class="font-semibold">Ready when you are.</h3><p>Opening, focus, submenus, and dismissal stay local. An application action still reaches C#.</p>
                <DropdownMenu InteractionMode="InteractionMode.Browser">
                    <DropdownMenuTrigger AsChild><Button data-testid="browser-menu" >Explore browser menu <LucideIcon Name="chevron-down" Size="16" /></Button></DropdownMenuTrigger>
                    <DropdownMenuContent Class="w-64">
                        <DropdownMenuLabel>Workspace actions</DropdownMenuLabel>
                        <DropdownMenuSeparator />
                        <DropdownMenuItem OnClick="RunBrowserAction">Save draft <span class="ml-auto pl-3 text-xs text-muted-foreground">async callback</span></DropdownMenuItem>
                        <DropdownMenuItem><a href="#selection-lab">Go to selection lab</a></DropdownMenuItem>
                        <DropdownMenuSub>
                            <DropdownMenuSubTrigger>Move to workspace</DropdownMenuSubTrigger>
                            <DropdownMenuSubContent>
                                <DropdownMenuItem OnClick="MoveToProduct">Product</DropdownMenuItem>
                                <DropdownMenuItem OnClick="MoveToDesign">Design</DropdownMenuItem>
                                <DropdownMenuItem Disabled>Archived workspace</DropdownMenuItem>
                            </DropdownMenuSubContent>
                        </DropdownMenuSub>
                        <DropdownMenuSeparator />
                        <DropdownMenuItem Disabled>Delete workspace (disabled)</DropdownMenuItem>
                    </DropdownMenuContent>
                </DropdownMenu>
                <p class="text-sm text-muted-foreground min-h-5" data-testid="browser-action">@browserAction</p>
            </article>
            <article class="space-y-4 min-w-0">
                <div class="flex flex-wrap items-center justify-between gap-2"><span class="rounded-md border px-2 py-1 text-xs font-medium">STANDARD BLAZOR</span><span class="text-xs text-muted-foreground">Click → server → render</span></div>
                <h3 class="font-semibold">The familiar server path.</h3><p>The default mode processes interactions through the active Blazor renderer, including a server round trip here.</p>
                <DropdownMenu>
                    <DropdownMenuTrigger AsChild><Button Variant="ButtonVariant.Outline" data-testid="standard-menu">Explore standard menu <LucideIcon Name="chevron-down" Size="16" /></Button></DropdownMenuTrigger>
                    <DropdownMenuContent Class="w-64">
                        <DropdownMenuLabel>Workspace actions</DropdownMenuLabel><DropdownMenuSeparator />
                        <DropdownMenuItem OnClick="RunStandardAction">Save draft</DropdownMenuItem>
                        <DropdownMenuItem>Browse workspace</DropdownMenuItem>
                        <DropdownMenuSub><DropdownMenuSubTrigger>Move to workspace</DropdownMenuSubTrigger><DropdownMenuSubContent><DropdownMenuItem>Product</DropdownMenuItem><DropdownMenuItem>Design</DropdownMenuItem></DropdownMenuSubContent></DropdownMenuSub>
                        <DropdownMenuSeparator /><DropdownMenuItem Disabled>Delete workspace (disabled)</DropdownMenuItem>
                    </DropdownMenuContent>
                </DropdownMenu>
                <p class="text-sm text-muted-foreground min-h-5" data-testid="standard-action">@standardAction</p>
            </article>
        </div>
        <div class="flex flex-wrap items-center justify-center gap-2 text-xs text-muted-foreground mt-6 [&>kbd]:rounded [&>kbd]:border [&>kbd]:px-1"><kbd>↑</kbd><kbd>↓</kbd> navigate <span>·</span><kbd>→</kbd> submenu <span>·</span><kbd>Esc</kbd> dismiss <span>·</span> type to find an item</div>
        </DemoBlock>
    </DemoSection>

    <div id="selection-lab" class="scroll-mt-24">
    <DemoSection Title="Select with asynchronous commits" Description="Change the workspace while a callback is pending. Selection updates immediately; older responses cannot replace your latest choice.">
        <DemoBlock Code="@sampleCode">
        <div class="grid gap-6 lg:grid-cols-2">
            <article class="space-y-4 min-w-0">
                <label class="block text-sm font-medium">Active workspace</label>
                <Select TValue="string" InteractionMode="InteractionMode.Browser" Value="@selectedWorkspace" ValueChanged="CommitWorkspace" Disabled="@selectDisabled" InteractionRevision="@selectionRevision" Class="w-full" >
                    <SelectTrigger data-testid="workspace-select"><SelectValue Placeholder="Choose a workspace" /></SelectTrigger>
                    <SelectContent>
                        @foreach (var workspace in workspaces)
                        {
                            <SelectItem @key="workspace" TValue="string" Value="@workspace" Text="@workspace" Disabled="@(workspace == "Archived")" />
                        }
                    </SelectContent>
                </Select>
                <div class="flex flex-wrap items-center justify-between gap-2 rounded-md border bg-muted/50 p-3 text-sm"><span>Last accepted by server</span><strong data-testid="accepted-workspace">@selectedWorkspace</strong></div>
                <div class="flex flex-wrap gap-2">
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="ResetSelection" Disabled="@(pendingCallbacks > 0)" data-testid="reset-selection">Reset selection</Button>
                    <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="AddWorkspace" Disabled="@(workspaces.Contains("Research"))" data-testid="add-workspace">Add “Research”</Button>
                </div>
                <label class="flex items-center gap-2 text-sm"><input type="checkbox" @bind="selectDisabled" data-testid="disable-select" /> Disable the select through Razor</label>
            </article>
            <aside class="space-y-4 min-w-0">
                <h3 class="font-semibold">Application behavior</h3>
                <label class="flex justify-between gap-2 text-sm" for="callback-delay">Callback delay <output>@callbackDelay ms</output></label>
                <input id="callback-delay" data-testid="callback-delay" class="w-full accent-primary" type="range" min="0" max="3000" step="250" @bind="callbackDelay" />
                <div class="flex justify-between text-xs text-muted-foreground"><span>Immediate</span><span>3 seconds</span></div>
                <label class="flex items-center gap-2 text-sm"><input type="checkbox" @bind="rejectSelection" data-testid="reject-selection" /> Server rejects selection changes</label>
                <p class="text-sm text-muted-foreground">Rejection restores the accepted value after the callback. This delay simulates application work, not network latency.</p>
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="RenderParent" data-testid="render-parent">Render parent (@parentRenders)</Button>
                <p class="text-sm text-muted-foreground">Open the select, then trigger a parent render. Its browser state stays intact.</p>
            </aside>
        </div>
        </DemoBlock>
    </DemoSection>
    </div>

    <DemoSection Title="Checkbox and radio menus" Description="Filter feedback stays local while application callbacks run. Use the delay and rejection settings above to distinguish pending choices from accepted values.">
        <DemoBlock Code="@filterCode">
            <div class="space-y-4">
                <DropdownMenu InteractionMode="InteractionMode.Browser" InteractionRevision="@filterRevision">
                    <DropdownMenuTrigger AsChild><Button Variant="ButtonVariant.Outline" data-testid="demo-filters">Inbox filters <LucideIcon Name="chevron-down" Size="16" /></Button></DropdownMenuTrigger>
                    <DropdownMenuContent Class="w-64">
                        <DropdownMenuLabel>Filters (keep open)</DropdownMenuLabel>
                        <DropdownMenuCheckboxItem Checked="@unreadOnly" CheckedChanged="CommitUnread">Unread only</DropdownMenuCheckboxItem>
                        <DropdownMenuCheckboxItem Checked="@mentionsOnly" CheckedChanged="CommitMentions">Mentions only</DropdownMenuCheckboxItem>
                        <DropdownMenuCheckboxItem Disabled>Assigned team (unavailable)</DropdownMenuCheckboxItem>
                        <DropdownMenuSeparator />
                        <DropdownMenuLabel>Notifications</DropdownMenuLabel>
                        <DropdownMenuRadioGroup TValue="string" Value="@notificationLevel" ValueChanged="CommitNotifications">
                            <DropdownMenuRadioItem TValue="string" Value="@("all")" CloseOnSelect="false">All notifications</DropdownMenuRadioItem>
                            <DropdownMenuRadioItem TValue="string" Value="@("important")" CloseOnSelect="false">Important only</DropdownMenuRadioItem>
                        </DropdownMenuRadioGroup>
                    </DropdownMenuContent>
                </DropdownMenu>
                <p class="text-sm text-muted-foreground" data-testid="demo-accepted-filters">Accepted: unread @unreadOnly, mentions @mentionsOnly, notifications @notificationLevel.</p>
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="ResetFilters">Reset filters</Button>
                <p class="text-sm text-muted-foreground">A visible checkmark is optimistic feedback. Pending items expose data-neo-pending; the accepted summary changes only after the callback.</p>
            </div>
        </DemoBlock>
    </DemoSection>

    <section id="menu-families">
        <DemoSection Title="Menu families and pill navigation" Description="Menubar, ContextMenu, NavigationMenu and SplitButton share the browser interaction policy. Try delayed callbacks while switching and dismissing menus.">
            <DemoBlock><BrowserMenuFamilies /></DemoBlock>
        </DemoSection>
    </section>

    <div id="composed-controls" class="scroll-mt-24">
    <DemoSection Title="Date, time, and composed controls" Description="One scoped policy keeps floating layers, item highlighting, and keyboard focus local. Application values, search callbacks, and newly rendered content still use Blazor.">
        <DemoBlock Code="@composedCode">
            <InteractionModeProvider Mode="InteractionMode.Browser" @key="composedRevision">
                <div class="grid gap-6 sm:grid-cols-2">
                    <article class="space-y-3 min-w-0" data-testid="demo-date-picker">
                        <h3 class="font-semibold">Date picker</h3>
                        <p class="text-sm text-muted-foreground">Open the calendar and navigate its visible days locally; choosing a date updates the bound value through Blazor.</p>
                        <DatePicker @bind-SelectedDate="appointmentDate" AriaLabel="Appointment date" Placeholder="Choose a date" Class="w-full" />
                        <p class="text-sm text-muted-foreground">Selected: <span class="font-medium text-foreground" data-testid="demo-date-value">@(appointmentDate?.ToString("yyyy-MM-dd") ?? "None")</span></p>
                        <a href="/components/date-picker" class="text-sm underline underline-offset-4">DatePicker examples</a>
                    </article>
                    <article class="space-y-3 min-w-0" data-testid="demo-time-picker">
                        <h3 class="font-semibold">Time picker</h3>
                        <p class="text-sm text-muted-foreground">Open locally, then use the existing time fields and Apply action to commit a time.</p>
                        <TimePicker @bind-SelectedTime="appointmentTime" MinuteStep="15" Placeholder="Choose a time" Class="w-full" />
                        <p class="text-sm text-muted-foreground">Selected: <span class="font-medium text-foreground" data-testid="demo-time-value">@(appointmentTime?.ToString("HH:mm") ?? "None")</span></p>
                        <a href="/components/time-picker" class="text-sm underline underline-offset-4">TimePicker examples</a>
                    </article>
                    <article class="space-y-3 min-w-0" data-testid="demo-combobox">
                        <h3 class="font-semibold">Combobox</h3>
                        <p class="text-sm text-muted-foreground">Hover highlighting and keyboard navigation stay local. Searching and committing a workspace still use Blazor.</p>
                        <Combobox TItem="string" SearchInterval="250" Items="@composedWorkspaces" ValueSelector="@(item => item)" DisplaySelector="@(item => item)" @bind-Value="assignedWorkspace" Placeholder="Assign a workspace" SearchPlaceholder="Search workspaces" Class="w-full" />
                        <p class="text-sm text-muted-foreground">Selected: <span class="font-medium text-foreground" data-testid="demo-combo-value">@(assignedWorkspace ?? "None")</span></p>
                        <a href="/components/combobox" class="text-sm underline underline-offset-4">Combobox examples</a>
                    </article>
                    <article class="space-y-3 min-w-0" data-testid="demo-multiselect">
                        <h3 class="font-semibold">Multi-select</h3>
                        <p class="text-sm text-muted-foreground">Hover, keyboard navigation, and dismissal stay local. Keep the list open while Blazor updates the selected teams.</p>
                        <MultiSelect TItem="string" SearchInterval="250" Items="@composedWorkspaces" ValueSelector="@(item => item)" DisplaySelector="@(item => item)" @bind-Values="notifiedWorkspaces" Placeholder="Notify workspaces" SearchPlaceholder="Search notification workspaces" Class="w-full" />
                        <p class="text-sm text-muted-foreground">Selected: <span class="font-medium text-foreground" data-testid="demo-multi-value">@(notifiedWorkspaces.Any() ? string.Join(", ", notifiedWorkspaces) : "None")</span></p>
                        <a href="/components/multi-select" class="text-sm underline underline-offset-4">MultiSelect examples</a>
                    </article>
                </div>
            </InteractionModeProvider>
            <div class="mt-6 flex flex-wrap items-center gap-3">
                <Button Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="ResetComposed" data-testid="demo-composed-reset">Reset values</Button>
                <p class="text-sm text-muted-foreground">These examples inherit Browser mode without setting it on each control.</p>
            </div>
        </DemoBlock>
    </DemoSection>
    </div>

    <div id="input-drafts" class="scroll-mt-24">
    <DemoSection Title="Type freely while the server works" Description="The browser owns the draft and caret. These callbacks deliberately wait 700 ms; old responses cannot overwrite newer typing. Use an explicit revision to reset a draft.">
        <DemoBlock Code="@inputCode">
            <div class="grid gap-6 sm:grid-cols-2">
                <article class="space-y-3 min-w-0">
                    <Label For="demo-draft-input">Update on input</Label>
                    <Input Id="demo-draft-input" InteractionMode="InteractionMode.Browser" Value="@acceptedDraft" ValueChanged="CommitDraft" ValueRevision="@draftRevision" UpdateOn="InputUpdateMode.Input" Placeholder="Keep typing during the delay" data-testid="demo-browser-input" />
                    <p class="text-sm text-muted-foreground">Accepted: <span class="font-medium text-foreground" data-testid="demo-input-accepted">@acceptedDraft</span></p>
                </article>
                <article class="space-y-3 min-w-0">
                    <Label For="demo-change-draft">Update on change</Label>
                    <Input Id="demo-change-draft" InteractionMode="InteractionMode.Browser" Value="@acceptedChangeDraft" ValueChanged="CommitChangeDraft" ValueRevision="@draftRevision" UpdateOn="InputUpdateMode.Change" Placeholder="Type, then leave this field" data-testid="demo-change-input" />
                    <p class="text-sm text-muted-foreground">Accepted: <span class="font-medium text-foreground" data-testid="demo-change-accepted">@acceptedChangeDraft</span></p>
                </article>
            </div>
            <div class="mt-4 flex flex-wrap items-center gap-3">
                <Button Variant="ButtonVariant.Outline" OnClick="ResetDrafts" data-testid="demo-input-reset">Reset drafts</Button>
                <Button Variant="ButtonVariant.Outline" OnClick="RenderParent" data-testid="demo-input-render">Render parent</Button>
                <label class="flex items-center gap-2 text-sm"><input type="checkbox" @bind="rejectDraft" data-testid="demo-input-reject" />Reject edits</label>
            </div>
            <p class="mt-3 text-sm text-muted-foreground">Local text is a draft until accepted. Rejection restores the accepted value after the latest callback. An interrupted request can have an uncertain outcome.</p>
        </DemoBlock>
    </DemoSection>
    </div>

    <div id="form-submission" class="scroll-mt-24">
    <DemoSection Title="Save the latest draft" Description="Type quickly and save immediately. BrowserEditForm keeps existing EditForm handlers and validators, flushes pending drafts before validation, and holds the snapshot through Save.">
        <DemoBlock Code="@formCode">
            <Dialog @bind-Open="editorOpen">
                <DialogTrigger AsChild><Button data-testid="demo-open-input-form">Edit profile in a dialog</Button></DialogTrigger>
                <DialogContent>
                    <DialogHeader><DialogTitle>Save the latest browser draft</DialogTitle><DialogDescription>Name callbacks wait 600 ms. The note has a 1.2-second debounce; Save flushes both before validating.</DialogDescription></DialogHeader>
                    <InteractionModeProvider Mode="InteractionMode.Browser">
                    <BrowserEditForm novalidate @ref="profileForm" Model="@profileDraft" OnValidSubmit="SaveProfileDraft" OnInvalidSubmit="ProfileInvalid" OnFlushFailed="ProfileFlushFailed" FormName="browser-interaction-profile" data-testid="demo-safe-form">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-sm text-destructive" />
                        <div class="space-y-4 py-4">
                            <div class="space-y-2"><Label For="demo-profile-name">Name (at least 4 characters)</Label><Input Id="demo-profile-name" Value="@profileDraft.Name" ValueChanged="CommitProfileName" ValueExpression="@(() => profileDraft.Name)" ValueRevision="@profileRevision" UpdateOn="InputUpdateMode.Input" Placeholder="Type a profile name" /></div>
                            <div class="space-y-2"><Label For="demo-profile-note">Note</Label><Input Id="demo-profile-note" @bind-Value="profileDraft.Note" ValueRevision="@profileRevision" UpdateOn="InputUpdateMode.Input" DebounceDelay="1200" Placeholder="Type a note and save immediately" /></div>
                            <p class="text-sm text-muted-foreground" role="status" data-testid="demo-form-feedback">@profileFeedback</p>
                        </div>
                        <DialogFooter>
                            <Button Type="ButtonType.Submit" Disabled="@(profileForm?.IsSubmitting == true)" aria-busy="@((profileForm?.IsSubmitting == true).ToString().ToLowerInvariant())" data-testid="demo-form-save">
                                @if (profileForm?.IsSubmitting == true)
                                {
                                    <LucideIcon Name="loader-circle" Size="16" Class="animate-spin" aria-hidden="true" />
                                    <span>Saving…</span>
                                }
                                else { <span>Save profile</span> }
                            </Button>
                        </DialogFooter>
                    </BrowserEditForm>
                    </InteractionModeProvider>
                </DialogContent>
            </Dialog>
            <Button Variant="ButtonVariant.Outline" OnClick="ResetProfileDraft" Class="ml-2">Reset profile</Button>
            <p class="mt-3 text-sm text-muted-foreground">Saved: <span class="font-medium text-foreground" data-testid="demo-profile-saved">@savedProfile</span></p>
            <p class="mt-2 text-sm text-muted-foreground">Rejected or corrected values, incomplete composition, resets and uncertain delivery stop submission. Review the field and submit again.</p>
        </DemoBlock>
    </DemoSection>
    </div>

    <DemoSection Title="Enable actions before blur" Description="Change mode notifies only on empty ↔ non-empty transitions while typing. Further non-empty typing stays local until blur/change or an explicit Save flush.">
        <DemoBlock Code="@boundaryCode">
            <div class="space-y-3 max-w-md">
                <Label For="demo-boundary-input">Type to enable Continue; clear to disable it</Label>
                <Input Id="demo-boundary-input" InteractionMode="InteractionMode.Browser" Value="@boundaryValue" ValueChanged="BoundaryChanged" UpdateOn="InputUpdateMode.Change" data-testid="demo-boundary-input" />
                <Button Disabled="@string.IsNullOrEmpty(boundaryValue)" data-testid="demo-boundary-action">Continue</Button>
                <p class="text-sm text-muted-foreground">Callbacks: <span data-testid="demo-boundary-calls">@boundaryCalls</span> · accepted value: <span data-testid="demo-boundary-value">@(boundaryValue ?? "(empty)")</span></p>
            </div>
        </DemoBlock>
    </DemoSection>

    <DemoSection Title="Adopt a policy with exceptions" Description="Explicit component setting → nearest scoped override → application default → library Blazor default.">
        <DemoBlock Code="@policyCode">
            <InteractionModeProvider Mode="InteractionMode.Browser">
                <div class="space-y-3" data-testid="browser-theme-picker">
                    <h3 class="font-semibold">Live Blazor content inside a browser popover</h3>
                    <p class="text-sm text-muted-foreground">This theme picker inherits Browser mode. Its buttons still execute the existing Blazor theme handlers.</p>
                    <ThemeSwitcher ShowStyles />
                </div>
            </InteractionModeProvider>
        </DemoBlock>
        <p class="text-sm text-muted-foreground">The date/time pickers, Combobox, and MultiSelect above inherit this policy too. Their floating shells and transient focus become local; search, value commits, and new calendar content remain Blazor interactions. Large lists and repeated row menus may be better kept in Blazor mode with mount-on-demand content.</p>
    </DemoSection>

    <DemoSection Title="Popover and browser events" Description="Open a floating layer and watch its events without adding server callbacks.">
    <DemoBlock>
    <div class="grid gap-6 lg:grid-cols-2">
        <article class="space-y-4 min-w-0">
            <span class="text-xs font-medium text-muted-foreground">03 / FLOAT WITHOUT WAITING</span><h3 class="font-semibold">Small layer. Local behavior.</h3>
            <p>This popover opens, positions, takes focus, and dismisses in the browser. These native controls need no application callback.</p>
            <Popover InteractionMode="InteractionMode.Browser">
                <PopoverTrigger AsChild><Button Variant="ButtonVariant.Outline" data-testid="browser-popover"><LucideIcon Name="sliders-horizontal" Size="16" /> Display options</Button></PopoverTrigger>
                <PopoverContent Class="w-72">
                    <div class="grid gap-3 text-sm [&_label]:flex [&_label]:items-center [&_label]:gap-2 [&_small]:text-muted-foreground"><h3 class="font-semibold">Display options</h3><p>Preferences for this local preview.</p>
                        <label><input type="checkbox" checked /> Show workspace avatars</label>
                        <label><input type="checkbox" /> Compact row spacing</label>
                        <label><input type="checkbox" checked /> Show activity indicators</label>
                        <small>Click outside or press Escape to close.</small>
                    </div>
                </PopoverContent>
            </Popover>
        </article>
        <article class="space-y-4 min-w-0">
            <div class="flex flex-wrap items-center justify-between gap-2"><div><span class="text-xs font-medium text-muted-foreground">LIVE IN YOUR BROWSER</span><h3 class="font-semibold">Local event stream</h3></div><span class="size-2 rounded-full bg-primary" aria-label="Live"></span></div>
            <p class="text-sm text-muted-foreground" data-empty-log>Open a browser-mode component to see its events.</p>
            <ol class="space-y-2 text-xs text-muted-foreground [&>li]:grid [&>li]:grid-cols-[3rem_1fr_auto] [&>li]:gap-2 [&>li]:border-b [&>li]:pb-2 [&_span]:truncate" data-event-log aria-label="Recent browser events"></ol>
        </article>
    </div>
    </DemoBlock>
    </DemoSection>

    <p class="text-sm text-muted-foreground">Browser mode supports action/link menus, checkbox and radio items, submenus, popovers, and selects. Local feedback does not confirm server acceptance; circuit interruptions can leave requests uncertain.</p>
    <DemoPageNav />
</div>

@code {
    private sealed class ProfileDraft {
        [Required, MinLength(4)] public string? Name { get; set; }
        [Required] public string? Note { get; set; }
    }
    private BrowserEditForm? profileForm;
    private readonly ProfileDraft profileDraft = new();
    private bool editorOpen;
    private long profileRevision;
    private const string ProfileFormHint = "Type freely, then save. Validation uses the synchronized model.";
    private string profileFeedback = ProfileFormHint;
    private string savedProfile = "None";
    private string? boundaryValue;
    private int boundaryCalls;
    private void BoundaryChanged(string? value) { boundaryValue = value; boundaryCalls++; }
    private void ResetProfileDraft() { profileDraft.Name = profileDraft.Note = null; profileRevision++; profileFeedback = "Draft reset."; }
    private async Task CommitProfileName(string? value) { var revision = profileRevision; await Task.Delay(600); if (revision == profileRevision) profileDraft.Name = value; }
    private async Task SaveProfileDraft(EditContext _) { profileFeedback = "Saving…"; var snapshot = $"{profileDraft.Name} · {profileDraft.Note}"; await Task.Delay(500); savedProfile = snapshot; profileFeedback = ProfileFormHint; editorOpen = false; }
    private void ProfileInvalid(EditContext _) => profileFeedback = "Review the validation errors before saving.";
    private void ProfileFlushFailed(InputFlushResult result) => profileFeedback = $"Not saved: {result.Status}. Review the current field value and try again.";
    private const string formCode = """
        @* With a global Browser default, an existing EditForm only changes its tag. *@
        <BrowserEditForm Model="@model" OnValidSubmit="SaveAsync" novalidate
                         OnFlushFailed="ShowSyncFeedback">
            <DataAnnotationsValidator />
            <ValidationSummary />
            <Input @bind-Value="model.Name" UpdateOn="InputUpdateMode.Input" />
            <Button Type="ButtonType.Submit">Save</Button>
        </BrowserEditForm>
        // ConfigureNeoUIInteractions(options => options.DefaultMode = InteractionMode.Browser)
        // Or use InteractionModeProvider around the form, as this demo does.
        // Existing OnSubmit handlers still own validation; valid/invalid handlers keep automatic validation.
        // Flush → acknowledge → validate → save. Inputs stay locked through Save.
        // Existing EditForm: use BrowserInputScope.SubmitAsync from OnSubmit.
        """;
    private const string boundaryCode = """
        <Input InteractionMode="InteractionMode.Browser"
