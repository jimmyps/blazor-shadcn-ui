    public async ValueTask DisposeAsync()
    {
        if (controller != null)
        {
            try { await controller.InvokeVoidAsync("dispose"); await controller.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
        if (module != null)
        {
            try { await module.DisposeAsync(); } catch (JSDisconnectedException) { }
        }
    }
