        """;

    private ElementReference pageRoot;
    private IJSObjectReference? module, controller;
    private readonly List<string> workspaces = ["Design", "Product", "Engineering", "Growth", "Archived"];
    private string? selectedWorkspace = "Design";
    private string browserAction = "Try Save draft to run an application callback.";
    private string standardAction = "Existing behavior is still the default.";
    private int callbackDelay = 1500, callbackCount, pendingCallbacks, parentRenders;
    private long selectionRevision;
    private bool selectDisabled, rejectSelection;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/NeoUI.Demo.Shared/Pages/Components/BrowserInteractionsDemo.razor.js");
        controller = await module.InvokeAsync<IJSObjectReference>("initialize", pageRoot);
    }

    private async Task CommitWorkspace(string? proposed)
    {
        var shouldReject = rejectSelection;
        await ApplicationWork();
        if (!shouldReject && workspaces.Contains(proposed ?? "") && proposed != "Archived") selectedWorkspace = proposed;
    }
    private async Task ApplicationWork()
    {
        var delay = callbackDelay;
        callbackCount++;
        pendingCallbacks++;
        StateHasChanged();
        try { await Task.Delay(delay); }
        finally { pendingCallbacks--; }
    }
    private async Task RunBrowserAction() { browserAction = "Saving draft… the menu has already closed."; await ApplicationWork(); browserAction = "Draft saved. The UI never waited for this callback."; }
    private async Task RunStandardAction() { standardAction = "Saving draft…"; await ApplicationWork(); standardAction = "Draft saved through the standard path."; }
    private async Task MoveToProduct() { await ApplicationWork(); browserAction = "Draft moved to Product."; }
    private async Task MoveToDesign() { await ApplicationWork(); browserAction = "Draft moved to Design."; }
    private void ResetSelection() { selectedWorkspace = "Design"; selectionRevision++; }
    private void AddWorkspace() { if (!workspaces.Contains("Research")) workspaces.Add("Research"); }
    private void RenderParent() => parentRenders++;

    private bool unreadOnly, mentionsOnly;
    private string? notificationLevel = "all";
    private long filterRevision;
    private async Task CommitFilter(Action accept)
    {
        var revision = filterRevision;
        var reject = rejectSelection;
        await ApplicationWork();
        if (!reject && filterRevision == revision) accept();
    }
    private Task CommitUnread(bool value) => CommitFilter(() => unreadOnly = value);
    private Task CommitMentions(bool value) => CommitFilter(() => mentionsOnly = value);
    private Task CommitNotifications(string? value) => CommitFilter(() => notificationLevel = value);
    private void ResetFilters() { unreadOnly = mentionsOnly = false; notificationLevel = "all"; filterRevision++; }

    private DateOnly? appointmentDate;
    private TimeOnly? appointmentTime;
    private string? assignedWorkspace;
    private IEnumerable<string> notifiedWorkspaces = [];
    private long composedRevision;
    private readonly string[] composedWorkspaces = ["Design", "Product", "Engineering", "Support"];
    private void ResetComposed()
    {
        appointmentDate = null;
        appointmentTime = null;
        assignedWorkspace = null;
        notifiedWorkspaces = [];
        // Recreate this example scope to clear each control's in-progress draft too.
        composedRevision++;
    }
