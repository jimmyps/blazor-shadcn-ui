    private string? acceptedDraft = "Hello", acceptedChangeDraft = "Hello";
    private long draftRevision;
    private bool rejectDraft;
    private async Task CommitDraft(string? value) { var revision = draftRevision; var reject = rejectDraft; await Task.Delay(700); if (revision == draftRevision && !reject) acceptedDraft = value; }
    private async Task CommitChangeDraft(string? value) { var revision = draftRevision; var reject = rejectDraft; await Task.Delay(700); if (revision == draftRevision && !reject) acceptedChangeDraft = value; }
    private void ResetDrafts() { acceptedDraft = acceptedChangeDraft = "Hello"; draftRevision++; }
