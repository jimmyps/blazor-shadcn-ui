@namespace NeoUI.Blazor

<button 
    type="button"
    role="@(ParentGroup?.Type == ToggleGroupType.Single ? "radio" : "checkbox")"
    aria-checked="@(ParentGroup?.BrowserInteraction == true ? null : IsSelected ? "true" : "false")"
    data-neo-field-item="@(ParentGroup?.BrowserInteraction == true ? Value : null)"
    disabled="@(Disabled || ParentGroup?.Disabled == true)"
    @onclick="@(ParentGroup?.BrowserInteraction == true ? default(EventCallback<MouseEventArgs>) : EventCallback.Factory.Create<MouseEventArgs>(this, OnClickAsync))"
    class="@CssClass">
    @ChildContent
</button>
