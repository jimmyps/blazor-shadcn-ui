@namespace NeoUI.Blazor

<BrowserStateHost Enabled="@BrowserInteraction" Kind="togglegroup" IsField Values="@BrowserValues" AcceptedValues="@AcceptedBrowserValues" Revision="@InteractionRevision" Disabled="@Disabled" Changed="ChangeBrowser" Multiple="@(Type == ToggleGroupType.Multiple)" Collapsible="@(!Required)" FieldOptions="@(new { required = Required })">
<div role="group" class="@CssClass">
    <CascadingValue Value="this">
        @ChildContent
    </CascadingValue>
</div>

</BrowserStateHost>
