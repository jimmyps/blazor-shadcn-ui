@namespace NeoUI.Blazor
@typeparam TValue

@if (BrowserInteraction)
{
    <BrowserFormattedInput @ref="browserInput" InteractionMode="NeoUI.Blazor.Primitives.InteractionMode.Browser"
        Id="@EffectiveId" Name="@(EffectiveName ?? string.Empty)" Class="@CssClass" Value="@BrowserValue"
        DraftIsValid="@(() => browserDraftValid)" AcceptDraft="@AcceptBrowserDraft" EquivalentValue="@EquivalentBrowserValue" FormatAccessor="@(() => BrowserFormat)" ValueRevision="@ValueRevision" NotifyOnEmptinessChange="@NotifyOnEmptinessChange"
        UpdateOn="@UpdateOn" DebounceDelay="@DebounceDelay" Placeholder="@Placeholder" Disabled="@Disabled" Readonly="@Readonly"
        Required="@Required" InputMode="@("decimal")" Autofocus="@Autofocus"
        AriaLabel="@AriaLabel" AriaDescribedBy="@AriaDescribedBy" AriaInvalid="@EffectiveAriaInvalid"
        AdditionalAttributes="@AdditionalAttributes" MaxLength="@MaxLength" />
}
else
{
var format = GetCultureInfo().NumberFormat;
<input id="@EffectiveId"
name="@EffectiveName"
type="text"
inputmode="decimal"
class="@CssClass"
value="@CurrentValueAsString"
data-neo-currency-edit=""
data-neo-currency-symbol="@CurrencyDefinition.Symbol"
data-neo-culture-symbol="@format.CurrencySymbol"
data-neo-number-group="@format.NumberGroupSeparator"
data-neo-currency-group="@format.CurrencyGroupSeparator"
data-neo-number-decimal="@format.NumberDecimalSeparator"
data-neo-negative-sign="@format.NegativeSign"
data-neo-positive-sign="@format.PositiveSign"
placeholder="@Placeholder"
disabled="@Disabled"
required="@Required"
readonly="@Readonly"
maxlength="@MaxLength"
autofocus="@Autofocus"
aria-label="@AriaLabel"
aria-describedby="@AriaDescribedBy"
aria-invalid="@(EffectiveAriaInvalid?.ToString().ToLower())"
@onfocus="HandleFocus"
@onblur="HandleBlur"
@attributes="AdditionalAttributes" />


}
