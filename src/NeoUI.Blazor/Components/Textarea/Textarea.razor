@namespace NeoUI.Blazor

@if (BrowserInteraction)
{
    <BrowserTextareaInput @ref="browserInput" InteractionMode="NeoUI.Blazor.Primitives.InteractionMode.Browser"
        Id="@EffectiveId" Name="@(EffectiveName ?? string.Empty)" Class="@CssClass" Value="@Value" ValueChanged="@ValueChanged"
        ValueExpression="@ValueExpression" AcceptedValueAccessor="@AcceptedValueAccessor" ValueRevision="@ValueRevision"
        UpdateOn="@UpdateOn" DebounceDelay="@DebounceDelay" Placeholder="@Placeholder" Disabled="@Disabled" Readonly="@Readonly"
        Required="@Required" Rows="@Rows" Cols="@Cols" Wrap="@Wrap" Autocomplete="@Autocomplete"
        MaxLength="@MaxLength" MinLength="@MinLength" InputMode="@InputMode" Autofocus="@Autofocus" Spellcheck="@Spellcheck"
        AriaLabel="@AriaLabel" AriaDescribedBy="@AriaDescribedBy" AriaInvalid="@AriaInvalid" ShowValidationError="@ShowValidationError"
        data-slot="textarea-control" />
}
else
{
<textarea
    id="@EffectiveId"
    name="@EffectiveName"
    class="@CssClass"
    value="@Value"
    placeholder="@Placeholder"
    disabled="@Disabled"
    required="@Required"
    readonly="@Readonly"
    autocomplete="@Autocomplete"
    maxlength="@MaxLength"
    minlength="@MinLength"
    rows="@Rows"
    cols="@Cols"
    wrap="@Wrap"
    inputmode="@InputMode"
    autofocus="@Autofocus"
    spellcheck="@(Spellcheck?.ToString().ToLower())"
    aria-label="@AriaLabel"
    aria-describedby="@AriaDescribedBy"
    aria-invalid="@(EffectiveAriaInvalid?.ToString().ToLower())"
    data-slot="textarea-control"></textarea>
}
