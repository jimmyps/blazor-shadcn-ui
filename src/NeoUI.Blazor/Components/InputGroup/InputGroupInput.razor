@namespace NeoUI.Blazor

@if (BrowserInteraction)
{
    <Input @ref="browserInput" InteractionMode="NeoUI.Blazor.Primitives.InteractionMode.Browser"
        Id="@EffectiveId" Name="@string.Empty" Type="@Type" Class="@ClassNames.cn(CssClass, "shadow-none focus-visible:ring-0 focus-visible:border-transparent")"
        Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression" ValueRevision="@ValueRevision"
        AcceptedValueAccessor="@AcceptedValueAccessor" UpdateOn="@UpdateOn" DebounceDelay="@DebounceDelay"
        Placeholder="@Placeholder" Disabled="@Disabled" Readonly="@Readonly" Required="@Required"
        AriaLabel="@AriaLabel" AriaDescribedBy="@AriaDescribedBy" AriaInvalid="@AriaInvalid"
        OnInputRef="@(element => { _inputRef = element; OnInputRef?.Invoke(element); })" AdditionalAttributes="@BrowserAttributes" />
}
else
{
@* Input/change events are wired through the shared input.js module (see OnAfterRenderAsync)
   so debouncing runs in the browser without a per-keystroke round-trip. *@
<input
    @ref="_inputRef"
    id="@EffectiveId"
    type="@HtmlType"
    data-slot="input-group-control"
    class="@CssClass"
    value="@Value"
    placeholder="@Placeholder"
    disabled="@Disabled"
    required="@Required"
    readonly="@Readonly"
    aria-label="@AriaLabel"
    aria-describedby="@AriaDescribedBy"
    aria-invalid="@(AriaInvalid?.ToString().ToLower())"
    @attributes="AdditionalAttributes" />
}
