@namespace NeoUI.Blazor

<BrowserStateHost Enabled="@BrowserInteraction" Kind="range" IsField Values="@BrowserValues" AcceptedValues="@AcceptedBrowserValues" Revision="@InteractionRevision" Disabled="@Disabled" Changed="ChangeBrowser" FieldOptions="@BrowserOptions">
<div @ref="_containerRef"
     id="@Id"
     class="@ContainerCssClass"
     role="group"
     aria-label="@(AriaLabel ?? "Range slider")"
     @attributes="AdditionalAttributes">
    
    @if (ShowLabels)
    {
        <div class="@LabelCssClass">
            <span class="text-xs text-muted-foreground">@Min</span>
            <span class="text-xs text-muted-foreground">@Max</span>
        </div>
    }
    
    <div class="@SliderContainerCssClass" data-neo-field-range="@(BrowserInteraction ? string.Empty : null)">
        @* Track background *@
        <div class="@TrackCssClass"></div>
        
        @* Range fill *@
        <div class="@RangeCssClass" data-neo-field-fill="@(BrowserInteraction ? string.Empty : null)" style="@(BrowserInteraction ? null : RangeStyle)"></div>
        
        @* Tick marks *@
        @if (ShowTicks && TickInterval.HasValue)
        {
            <div class="@TickContainerCssClass">
                @for (var i = Min; i <= Max; i += TickInterval.Value)
                {
                    var position = GetPercentage(i);
                    <div class="@TickCssClass" style="@GetTickStyle(position)"></div>
                }
            </div>
        }
        
        @* Min handle *@
        <div class="@HandleCssClass"
             data-neo-field-thumb="@(BrowserInteraction ? 0 : (int?)null)" style="@(BrowserInteraction ? null : MinHandleStyle)"
             role="slider"
             aria-label="@(Name != null ? $"{Name} minimum" : "Minimum value")"
             aria-valuemin="@Min"
             aria-valuemax="@Max"
             aria-valuenow="@(BrowserInteraction ? null : MinValue.ToString(System.Globalization.CultureInfo.InvariantCulture))"
             aria-orientation="@(Orientation == SliderOrientation.Horizontal ? "horizontal" : "vertical")"
             data-orientation="@(Orientation == SliderOrientation.Horizontal ? "horizontal" : "vertical")"
             aria-disabled="@(Disabled ? "true" : "false")"
             tabindex="@(Disabled ? -1 : 0)"
             data-handle="min"
             @onmousedown="@(BrowserInteraction ? default(EventCallback<MouseEventArgs>) : EventCallback.Factory.Create<MouseEventArgs>(this, OnMinHandleMouseDown))"
             @ontouchstart="@(BrowserInteraction ? default(EventCallback<TouchEventArgs>) : EventCallback.Factory.Create<TouchEventArgs>(this, OnMinHandleTouchStart))"
             @onkeydown="@(BrowserInteraction ? default(EventCallback<KeyboardEventArgs>) : EventCallback.Factory.Create<KeyboardEventArgs>(this, e => OnHandleKeyDown(e, true)))">
            @if (ShowTooltips)
            {
                <div class="@TooltipCssClass" data-neo-field-tooltip="@(BrowserInteraction ? 0 : (int?)null)">@(BrowserInteraction ? "" : MinValue.ToString("0.##"))</div>
            }
        </div>
        
        @* Max handle *@
        <div class="@HandleCssClass"
             data-neo-field-thumb="@(BrowserInteraction ? 1 : (int?)null)" style="@(BrowserInteraction ? null : MaxHandleStyle)"
             role="slider"
             aria-label="@(Name != null ? $"{Name} maximum" : "Maximum value")"
             aria-valuemin="@Min"
             aria-valuemax="@Max"
             aria-valuenow="@(BrowserInteraction ? null : MaxValue.ToString(System.Globalization.CultureInfo.InvariantCulture))"
             aria-orientation="@(Orientation == SliderOrientation.Horizontal ? "horizontal" : "vertical")"
             data-orientation="@(Orientation == SliderOrientation.Horizontal ? "horizontal" : "vertical")"
             aria-disabled="@(Disabled ? "true" : "false")"
             tabindex="@(Disabled ? -1 : 0)"
             data-handle="max"
             @onmousedown="@(BrowserInteraction ? default(EventCallback<MouseEventArgs>) : EventCallback.Factory.Create<MouseEventArgs>(this, OnMaxHandleMouseDown))"
             @ontouchstart="@(BrowserInteraction ? default(EventCallback<TouchEventArgs>) : EventCallback.Factory.Create<TouchEventArgs>(this, OnMaxHandleTouchStart))"
             @onkeydown="@(BrowserInteraction ? default(EventCallback<KeyboardEventArgs>) : EventCallback.Factory.Create<KeyboardEventArgs>(this, e => OnHandleKeyDown(e, false)))">
            @if (ShowTooltips)
            {
                <div class="@TooltipCssClass" data-neo-field-tooltip="@(BrowserInteraction ? 1 : (int?)null)">@(BrowserInteraction ? "" : MaxValue.ToString("0.##"))</div>
            }
        </div>
    </div>
</div>

</BrowserStateHost>
