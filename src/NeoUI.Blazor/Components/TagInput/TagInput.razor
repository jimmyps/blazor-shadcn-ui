@namespace NeoUI.Blazor
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@implements IAsyncDisposable

@if (BrowserInteraction)
{
    <BrowserStateHost Enabled Kind="tags" IsField Values="@(BrowserInteraction ? BrowserValues : Array.Empty<string>())" AcceptedValues="@AcceptedBrowserValues" Revision="@InteractionRevision" Disabled="@Disabled" Changed="ChangeBrowser" FieldOptions="@(BrowserInteraction ? BrowserOptions : null)" Search="SearchBrowser" Rejected="@OnTagRejected">
        <div @ref="_containerRef" id="@_containerId" class="@ContainerCssClass" @attributes="AdditionalAttributes">
            <span data-neo-tag-values class="contents"></span>
            <input type="text" data-neo-tag-input class="@InputCssClass" placeholder="@(Placeholder ?? Localizer["TagInput.Placeholder"])" disabled="@Disabled" aria-label="@(AriaLabel ?? "Add tag")" aria-autocomplete="@(HasSuggestions ? "list" : null)" aria-controls="@(HasSuggestions ? _contentId : null)" />
            @if (Clearable) { <button type="button" data-neo-tag-clear class="ml-auto text-xs" disabled="@Disabled" aria-label="@Localizer["TagInput.ClearAllTags"]">@Localizer["TagInput.ClearAllTags"]</button> }
            <span data-neo-tag-status class="sr-only" role="status"></span>
        </div>
    </BrowserStateHost>
    @if (HasSuggestions && browserMounted)
    {
        <FloatingPortal IsOpen="true" ForceMount="true" AnchorElement="@_containerRef" PortalId="@_portalId" Side="PopoverSide.Bottom" Align="PopoverAlign.Start" Offset="4" MatchAnchorWidth="true" ZIndex="60">
            <ul id="@_contentId" data-neo-floating-owner="@_containerId" role="listbox" hidden aria-label="@Localizer["TagInput.TagSuggestions"]" class="rounded-md border bg-popover text-popover-foreground shadow-md outline-none p-1 max-h-48 overflow-y-auto"></ul>
        </FloatingPortal>
    }
}
else
{
<div @ref="_containerRef"
     id="@_containerId"
     data-tag-input-container
     class="@ContainerCssClass"
     aria-label="@AriaLabel"
     aria-disabled="@(Disabled ? "true" : null)">

    @foreach (var tag in _currentTags)
    {
        @if (TagTemplate is not null)
        {
            <div @key="tag" class="contents">@TagTemplate(tag)</div>
        }
        else
        {
            <Badge @key="tag" Variant="@TagBadgeVariant" Class="gap-1 shrink-0">
                @tag
                @if (!Disabled)
                {
                    <button type="button"
                            class="ml-0.5 rounded-full outline-none focus-visible:ring-1 focus-visible:ring-ring hover:bg-secondary-foreground/20"
                            aria-label="@Localizer["TagInput.RemoveTag", tag]"
                            @onclick="GetRemoveHandler(tag)"
                            @onclick:stopPropagation="true">
                        <LucideIcon Name="x" Size="12" Class="h-3 w-3" />
                    </button>
                }
            </Badge>
        }
    }

    <input @ref="_inputRef"
           type="text"
           class="@InputCssClass"
           value="@_inputText"
           placeholder="@EffectivePlaceholder"
           disabled="@Disabled"
           aria-label="@(AriaLabel ?? "Add tag")"
           aria-autocomplete="@(HasSuggestions ? "list" : null)"
           aria-expanded="@(_suggestionsOpen ? "true" : null)"
           aria-controls="@(_suggestionsOpen ? _contentId : null)"
           aria-activedescendant="@ActiveDescendantId"
           @oninput="HandleInput"
           @onfocus="HandleFocus"
           @onblur="HandleBlur" />

    @if (Clearable && _currentTags.Count > 0 && !Disabled)
    {
        <button type="button"
                class="ml-auto shrink-0 rounded-sm opacity-70 hover:opacity-100 focus:outline-none focus-visible:ring-1 focus-visible:ring-ring"
                aria-label="@Localizer["TagInput.ClearAllTags"]"
                @onclick="ClearAll"
                @onclick:stopPropagation="true">
            <LucideIcon Name="x" Size="14" Class="h-3.5 w-3.5" />
        </button>
    }
</div>

@if (HasSuggestions)
{
    <FloatingPortal IsOpen="@(_suggestionsOpen && _filteredSuggestions.Count > 0)"
                    AnchorElement="@_containerRef"
                    PortalId="@_portalId"
                    Side="PopoverSide.Bottom"
                    Align="PopoverAlign.Start"
                    Offset="4"
                    MatchAnchorWidth="true"
                    ZIndex="60">
        <ul id="@_contentId" data-neo-floating-owner="@_containerId"
            role="listbox"
            aria-label="@Localizer["TagInput.TagSuggestions"]"
            class="rounded-md border bg-popover text-popover-foreground shadow-md outline-none p-1 max-h-48 overflow-y-auto">
            @for (int i = 0; i < _filteredSuggestions.Count; i++)
            {
                var suggestion = _filteredSuggestions[i];
                var index = i;
                var isActive = _suggestionIndex == index;
                <li @key="suggestion"
                    id="@($"{_instanceId}-suggestion-{index}")"
                    role="option"
                    aria-selected="@isActive.ToString().ToLower()"
                    class="@SuggestionItemCssClass(isActive)"
                    @onmousedown="() => SelectSuggestion(suggestion)"
                    @onmousedown:preventDefault="true">
                    @suggestion
                </li>
            }
        </ul>
    </FloatingPortal>
}

}
