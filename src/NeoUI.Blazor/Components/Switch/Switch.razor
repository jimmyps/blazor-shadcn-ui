@namespace NeoUI.Blazor
<SwitchPrimitive InteractionMode="@InteractionMode" InteractionRevision="@InteractionRevision" AcceptedValueAccessor="AcceptedBrowserValue" Name="@EffectiveName" Required="@Required" Checked="@Checked"
                 CheckedChanged="@HandleCheckedChanged"
                 Disabled="@Disabled"
                 Id="@Id"
                 aria-label="@AriaLabel"
                 aria-required="@(Required || CheckedExpression != null ? "true" : null)"
                 aria-invalid="@(IsInvalid ? "true" : null)"
                 class="@CssClass">
    <span data-neo-field-state data-state="@(BrowserInteraction ? null : Checked ? "checked" : "unchecked")" class="@ThumbCssClass">
    </span>
</SwitchPrimitive>

@* Hidden input for form submission *@
@if (!BrowserInteraction && !string.IsNullOrEmpty(EffectiveName))
{
    <input type="hidden" name="@EffectiveName" value="@(Checked ? "true" : "false")" />
}
