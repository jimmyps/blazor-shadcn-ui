@namespace NeoUI.Blazor
@using NeoUI.Icons.Lucide

<BrowserStateHost @ref="browserHost" Enabled="@BrowserInteraction" Kind="date" IsField Values="@(BrowserInteraction ? BrowserValues : Array.Empty<string>())" AcceptedValues="@AcceptedBrowserValues" Revision="@InteractionRevision" Disabled="@Disabled" Changed="ChangeBrowser" FieldOptions="@(BrowserInteraction ? BrowserOptions : null)">
<div class="@ContainerClass"
     id="@Id"
     role="group"
     aria-label="@(AriaLabel ?? "Date")"
     aria-disabled="@(Disabled ? "true" : null)"
     aria-required="@(Required ? "true" : null)"
     aria-invalid="@(AriaInvalid?.ToString().ToLower())"
     aria-describedby="@AriaDescribedBy"
     @ref="_containerRef"
     @onkeydown="@(BrowserInteraction ? default(EventCallback<KeyboardEventArgs>) : EventCallback.Factory.Create<KeyboardEventArgs>(this, HandleKeyDown))"
     @onfocusin="@(BrowserInteraction ? default(EventCallback<FocusEventArgs>) : EventCallback.Factory.Create<FocusEventArgs>(this, OnContainerFocusIn))"
     @onfocusout="@(BrowserInteraction ? default(EventCallback<FocusEventArgs>) : EventCallback.Factory.Create<FocusEventArgs>(this, OnContainerFocusOut))"
     @attributes="AdditionalAttributes">

    @if (!string.IsNullOrEmpty(Placeholder))
    {
        <span data-neo-segment-placeholder="@(BrowserInteraction ? string.Empty : null)" class="@(BrowserInteraction || _showPlaceholder ? "text-muted-foreground flex-1 cursor-text select-none truncate" : "sr-only")"
              aria-hidden="true"
              @onclick="@(BrowserInteraction ? default(EventCallback<MouseEventArgs>) : EventCallback.Factory.Create<MouseEventArgs>(this, FocusFirstSegment))">
            @Placeholder
        </span>
    }

    @foreach (var (seg, i) in _segments.Select((s, i) => (s, i)))
    {
        if (seg.IsLiteral)
        {
            <span data-neo-segment-literal="@(BrowserInteraction ? string.Empty : null)" class="@(!BrowserInteraction && _showPlaceholder ? "sr-only" : "text-muted-foreground select-none shrink-0")" aria-hidden="true">@seg.LiteralText</span>
        }
        else
        {
            var idx = i;
            <span tabindex="@(Disabled ? -1 : 0)"
                  role="spinbutton"
                  data-neo-segment="@(BrowserInteraction ? _segments.Take(i).Count(segment => !segment.IsLiteral) : (int?)null)"
                  aria-label="@GetSegmentAriaLabel(seg)"
                  aria-valuenow="@(BrowserInteraction ? null : seg.Value)"
                  aria-valuemin="@seg.Min"
                  aria-valuemax="@seg.Max"
                  class="@(!BrowserInteraction && _showPlaceholder ? "sr-only" : GetSegmentClass(seg))"
                  @onfocus="@(BrowserInteraction ? default(EventCallback<FocusEventArgs>) : EventCallback.Factory.Create<FocusEventArgs>(this, () => OnSegmentFocus(idx)))"
                  @onblur="@(BrowserInteraction ? default(EventCallback<FocusEventArgs>) : EventCallback.Factory.Create<FocusEventArgs>(this, OnSegmentBlur))">
                @(BrowserInteraction ? seg.Placeholder : GetSegmentDisplay(seg))
            </span>
        }
    }

    <span class="@(_showPlaceholder ? "hidden" : "flex-1")" aria-hidden="true"></span>

    @if (ShowPickerButton && !Disabled)
    {
        <Popover InteractionMode="@(BrowserInteraction ? NeoUI.Blazor.Primitives.InteractionMode.Browser : NeoUI.Blazor.Primitives.InteractionMode.Blazor)" @bind-Open="_isPickerOpen">
            <PopoverTrigger AsChild>
                <Button Variant="ButtonVariant.Ghost" Size="ButtonSize.IconSmall"
                        Class="h-auto w-auto p-0 text-muted-foreground hover:bg-transparent hover:text-foreground focus:outline-none"
                        tabindex="-1" AriaLabel="Open calendar">
                    <LucideIcon Name="calendar" Size="14" />
                </Button>
            </PopoverTrigger>
            <PopoverContent Class="w-auto !p-0" Align="PopoverAlign.End">
                <Calendar CloseOnSelect="true" SelectedDate="@_pickerDate"
                          SelectedDateChanged="OnPickerDateSelected"
                          MinDate="@MinDate"
                          MaxDate="@MaxDate"
                          IsDateDisabled="@IsDateDisabled"
                          Culture="@EffectiveCulture"
                          CaptionLayout="@CaptionLayout"
                          Class="border-0 shadow-none"
                          RowClass="!mt-0" />
            </PopoverContent>
        </Popover>
    }

    @if (!string.IsNullOrEmpty(Name))
    {
        <input type="hidden" name="@Name" value="@(BrowserInteraction ? null : HiddenValue)" data-neo-segment-hidden="@(BrowserInteraction ? string.Empty : null)" />
    }
</div>

</BrowserStateHost>
