@namespace NeoUI.Blazor

<BrowserStateHost Enabled="@BrowserInteraction" Kind="slider" IsField Values="@(BrowserInteraction ? BrowserValues : Array.Empty<string>())" AcceptedValues="@AcceptedBrowserValues" Revision="@InteractionRevision" Disabled="@Disabled" Changed="ChangeBrowser" FieldOptions="@(BrowserInteraction ? BrowserOptions : null)">
<div class="@ContainerCssClass">
    <input 
        type="range" 
        min="@Min" 
        max="@Max" 
        step="@Step" 
        value="@(BrowserInteraction ? null : Value.ToString(System.Globalization.CultureInfo.InvariantCulture))"
        data-neo-field-range="@(BrowserInteraction ? string.Empty : null)"
        @oninput="@(BrowserInteraction ? default(EventCallback<ChangeEventArgs>) : EventCallback.Factory.Create<ChangeEventArgs>(this, OnInputAsync))"
        @onchange="@(BrowserInteraction ? default(EventCallback<ChangeEventArgs>) : EventCallback.Factory.Create<ChangeEventArgs>(this, OnChangeAsync))"
        disabled="@Disabled"
        style="@(BrowserInteraction ? null : TrackStyle)"
        class="@CssClass" />
</div>

</BrowserStateHost>
