@namespace NeoUI.Blazor
<button
    type="@HtmlType"
    class="@CssClass"
    id="@(TriggerContext?.TriggerId)"
    @ref="_buttonRef"
    disabled="@(Disabled || TriggerContext?.Disabled == true)"
    tabindex="@(Disabled || TriggerContext?.Disabled == true ? -1 : 0)"
    aria-label="@AriaLabel"
    aria-disabled="@((Disabled || TriggerContext?.Disabled == true).ToString().ToLowerInvariant())"
    aria-haspopup="@(TriggerContext?.AriaHasPopup)"
    aria-expanded="@(TriggerContext != null && !TriggerContext.BrowserOwned ? TriggerContext.IsOpen.ToString().ToLower() : null)"
    aria-controls="@(TriggerContext?.AriaControls)"
    @onclick="@(TriggerContext?.BrowserOwned == true ? default(EventCallback<MouseEventArgs>) : EventCallback.Factory.Create<MouseEventArgs>(this, HandleClick))"
    @onkeydown="@(TriggerContext?.BrowserOwned == true || TriggerContext?.OnKeyDown == null ? default(EventCallback<KeyboardEventArgs>) : EventCallback.Factory.Create<KeyboardEventArgs>(this, HandleKeyDown))"
    @onmouseenter="@(TriggerContext?.BrowserOwned == true || TriggerContext?.OnMouseEnter == null ? default(EventCallback<MouseEventArgs>) : EventCallback.Factory.Create<MouseEventArgs>(this, HandleMouseEnter))"
    @onmouseleave="@(TriggerContext?.BrowserOwned == true || TriggerContext?.OnMouseLeave == null ? default(EventCallback<MouseEventArgs>) : EventCallback.Factory.Create<MouseEventArgs>(this, HandleMouseLeave))"
    @onfocus="@(TriggerContext?.BrowserOwned == true || TriggerContext?.OnFocus == null ? default(EventCallback<FocusEventArgs>) : EventCallback.Factory.Create<FocusEventArgs>(this, HandleFocus))"
    @onblur="@(TriggerContext?.BrowserOwned == true || TriggerContext?.OnBlur == null ? default(EventCallback<FocusEventArgs>) : EventCallback.Factory.Create<FocusEventArgs>(this, HandleBlur))"
    @attributes="AdditionalAttributes">
    @if (Icon != null && IconPosition == IconPosition.Start)
    {
        <span class="me-2">@Icon</span>
    }
    @ChildContent
    @if (Icon != null && IconPosition == IconPosition.End)
    {
        <span class="ms-2">@Icon</span>
    }
</button>
