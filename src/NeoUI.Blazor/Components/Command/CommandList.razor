@namespace NeoUI.Blazor
@inject ILocalizer Localizer
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<div id="@Context?.ListId"
     @ref="_scrollRef"
     @onscroll="@(Context?.BrowserInteraction != true && OnLoadMore.HasDelegate ? EventCallback.Factory.Create(this, HandleScroll) : default)"
     data-neo-load-enabled="@((CanLoadMore && !IsLoading && (AllowLoadMoreDuringSearch || string.IsNullOrEmpty(Context?.SearchQuery))).ToString().ToLowerInvariant())"
     class="@CssClass"
     role="listbox"
     aria-label="@Localizer["Command.ListAriaLabel"]">
    @ChildContent
    @if (IsLoading)
    {
        <div class="flex items-center justify-center py-2">
            <Spinner Size="SpinnerSize.Small" />
        </div>
    }
    else if (!string.IsNullOrEmpty(EndOfListMessage))
    {
        <div class="py-2 text-center text-xs text-muted-foreground">
            @EndOfListMessage
        </div>
    }
</div>

@code {
    private ElementReference _scrollRef;
    private IJSObjectReference? browserModule, browserScroll;
    private DotNetObjectReference<CommandList>? browserReference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Context?.BrowserInteraction != true || !OnLoadMore.HasDelegate || browserScroll != null) return;
        browserModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", "./_content/NeoUI.Blazor/js/browser-list.js");
        browserReference ??= DotNetObjectReference.Create(this);
        browserScroll = await browserModule.InvokeAsync<IJSObjectReference>("observeLoadMore", _scrollRef, browserReference);
    }

    /// <summary>Runs a page-load callback after the browser reaches the loading threshold.</summary>
    [JSInvokable]
    public Task LoadBrowserItems() => HandleScroll();

    private IJSObjectReference? _jsModule;
    private bool _loadMorePending;

    [CascadingParameter]
    public CommandContext? Context { get; set; }

    /// <summary>
    /// Gets or sets additional CSS classes to apply to the list container.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets the content to be rendered inside the list.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the callback invoked when the user scrolls near the bottom of the list.
    /// Use this to load additional items for infinite scroll scenarios.
    /// </summary>
    [Parameter]
    public EventCallback OnLoadMore { get; set; }

    /// <summary>
    /// Gets or sets whether additional items are currently being loaded.
    /// When true, a loading spinner is shown at the bottom of the list and
    /// <see cref="OnLoadMore"/> is suppressed until loading completes.
    /// </summary>
    [Parameter]
    public bool IsLoading { get; set; }

    /// <summary>
    /// Gets or sets a message displayed at the bottom of the list when all items have been loaded.
    /// Only shown when <see cref="IsLoading"/> is false. Set to <c>null</c> or empty to hide.
    /// </summary>
    [Parameter]
    public string? EndOfListMessage { get; set; }

    /// <summary>
    /// Gets or sets whether <see cref="OnLoadMore"/> can fire while the user has an active search
    /// query. When <c>false</c> (default), <see cref="OnLoadMore"/> is suppressed during search so
    /// that client-side filtering is not polluted by new unfiltered batches. Set to <c>true</c> when
    /// <c>SearchQueryChanged</c> is wired up and the consumer handles server-side filtering alongside
    /// paginated results.
    /// </summary>
    [Parameter]
    public bool AllowLoadMoreDuringSearch { get; set; } = false;

    /// <summary>
    /// Gets or sets whether more items remain to be loaded. When <c>false</c>,
    /// <see cref="OnLoadMore"/> is never invoked, so scrolling back to the bottom of a
    /// fully-loaded list does not trigger another pointless fetch.
    /// </summary>
    /// <remarks>
    /// Defaults to <c>true</c>. A non-empty <see cref="EndOfListMessage"/> also implies the end
    /// of the list has been reached and suppresses <see cref="OnLoadMore"/> on its own, so
    /// consumers that already drive that message do not need to set this parameter.
    /// </remarks>
    [Parameter]
    public bool HasMore { get; set; } = true;

    /// <summary>
    /// Whether another <see cref="OnLoadMore"/> invocation is worth attempting.
    /// </summary>
    private bool CanLoadMore =>
        OnLoadMore.HasDelegate && HasMore && string.IsNullOrEmpty(EndOfListMessage);

    /// <summary>
    /// Gets the computed CSS classes for the list container.
    /// </summary>
    private string CssClass
    {
        get
        {
            var baseClasses = "max-h-[300px] overflow-y-auto overflow-x-hidden";
            return string.IsNullOrWhiteSpace(Class) ? baseClasses : $"{baseClasses} {Class}";
        }
    }

    private async Task HandleScroll()
    {
        if (!CanLoadMore || IsLoading || _loadMorePending)
        {
            return;
        }

        // Suppress infinite scroll during active search when using client-side filter.
        // Allow it through only when the consumer has opted in (server-side filter + paginated results).
        if (!AllowLoadMoreDuringSearch && !string.IsNullOrEmpty(Context?.SearchQuery))
        {
            return;
        }

        if (Context?.BrowserInteraction == true) { await LoadPageAsync(); return; }

        _jsModule ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
            "import", "./_content/NeoUI.Blazor.Primitives/js/primitives/element-utils.js");

        try
        {
            var nearBottom = await _jsModule.InvokeAsync<bool>("isNearBottom", _scrollRef, 80.0);
            if (nearBottom)
            {
                // Scroll events keep arriving while the consumer's async handler runs, before it has
                // a chance to flip IsLoading. Latch locally so one gesture yields one page fetch.
                await LoadPageAsync();
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
        {
            // Expected during circuit disconnect or disposal
        }
    }

    private async Task LoadPageAsync()
    {
        _loadMorePending = true;
        try { await OnLoadMore.InvokeAsync(); }
        finally { _loadMorePending = false; }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (browserScroll != null) { await browserScroll.InvokeVoidAsync("dispose"); await browserScroll.DisposeAsync(); }
            if (browserModule != null) await browserModule.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
        browserReference?.Dispose();
        if (_jsModule != null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException)
            {
                // Expected during circuit disconnect
            }

            _jsModule = null;
        }
    }
}
