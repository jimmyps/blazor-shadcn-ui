@namespace NeoUI.Blazor
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject Microsoft.Extensions.Options.IOptions<InteractionOptions> InteractionDefaults
@inject ILocalizer Localizer

@* Command - self-contained searchable/filterable list component *@
<CascadingValue Value="_context" IsFixed="false">
    <div @ref="browserRoot" data-neo-client-list="@(_context.BrowserInteraction ? "command" : null)"
         data-neo-list-disabled="@Disabled.ToString().ToLowerInvariant()"
         data-neo-close-on-select="@CloseOnSelect.ToString().ToLowerInvariant()"
         class="@CssClass"
         role="group"
         aria-label="@Localizer["Command.MenuAriaLabel"]"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private CommandContext _context = new();
    private ElementReference browserRoot;
    private IJSObjectReference? browserModule, browserController;
    private readonly SemaphoreSlim browserGate = new(1, 1);
    private bool browserDisposed;
    private bool? browserMode;
    [CascadingParameter] private InteractionPolicy? InteractionPolicy { get; set; }
    [CascadingParameter] private PopoverContext? PopoverContext { get; set; }
    /// <summary>Local hover/navigation for mounted items. Omitted values inherit the enclosing popover or interaction policy.</summary>
    [Parameter] public InteractionMode? InteractionMode { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_context.BrowserInteraction || browserController != null) return;
        await browserGate.WaitAsync();
        try
        {
            if (browserDisposed || browserController != null) return;
            browserModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/NeoUI.Blazor/js/browser-list.js");
            browserController = await browserModule.InvokeAsync<IJSObjectReference>("initialize", browserRoot);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
        finally { browserGate.Release(); }
    }

    private string _searchQuery = string.Empty;

    /// <summary>
    /// Gets or sets additional CSS classes to apply to the command container.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Gets or sets the content to be rendered inside the command.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Gets or sets the current search query.
    /// </summary>
    [Parameter]
    public string SearchQuery
    {
        get => _searchQuery;
        set
        {
            if (_searchQuery != value)
            {
                _searchQuery = value;
                _context.SetSearchQuery(value);
            }
        }
    }

    /// <summary>
    /// Event callback invoked when the search query changes.
    /// </summary>
    [Parameter]
    public EventCallback<string> SearchQueryChanged { get; set; }

    /// <summary>
    /// Event callback invoked when an item is selected.
    /// </summary>
    [Parameter]
    public EventCallback<string> OnValueChange { get; set; }

    /// <summary>
    /// Custom filter function for items.
    /// </summary>
    [Parameter]
    public Func<CommandItemMetadata, string, bool>? FilterFunction { get; set; }

    /// <summary>
    /// Whether the command is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Whether to close the dropdown after an item is selected.
    /// Default is true (standard command behavior).
    /// Set to false for multi-select scenarios.
    /// </summary>
    [Parameter]
    public bool CloseOnSelect { get; set; } = true;

    /// <summary>
    /// Gets or sets additional attributes to apply to the component.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Gets the computed CSS classes for the command container.
    /// </summary>
    [CascadingParameter(Name = "StyleVariant")]
    private StyleVariant _styleVariant { get; set; } = StyleVariant.Default;

    private string CssClass => ClassNames.cn(
        "flex h-full w-full flex-col overflow-hidden rounded-md bg-popover text-popover-foreground",
        _styleVariant.GetClasses("Command.Content"),
        Class
    );

    protected override void OnInitialized()
    {
        _context.BrowserInteraction = ComposedInteraction.IsBrowser(InteractionMode, InteractionPolicy, InteractionDefaults.Value, PopoverContext);
        _context.OnValueChange = OnValueChange;
        _context.FilterFunction = FilterFunction;
        _context.CloseOnSelect = CloseOnSelect;
        _context.Disabled = Disabled;
        _context.OnStateChanged += HandleContextStateChanged;
    }

    protected override void OnParametersSet()
    {
        var mode = ComposedInteraction.IsBrowser(InteractionMode, InteractionPolicy, InteractionDefaults.Value, PopoverContext);
        if (browserMode.HasValue && browserMode != mode) throw new InvalidOperationException("InteractionMode cannot change after initialization. Recreate the component with @key.");
        browserMode = mode;
        _context.BrowserInteraction = ComposedInteraction.IsBrowser(InteractionMode, InteractionPolicy, InteractionDefaults.Value, PopoverContext);
        _context.OnValueChange = OnValueChange;
        _context.FilterFunction = FilterFunction;
        _context.CloseOnSelect = CloseOnSelect;
        _context.Disabled = Disabled;

        // Sync search query from parameter
        if (_context.SearchQuery != _searchQuery)
        {
            _context.SetSearchQuery(_searchQuery);
        }
    }

    private async void HandleContextStateChanged()
    {
        // Sync search query back to parameter
        if (_searchQuery != _context.SearchQuery)
        {
            _searchQuery = _context.SearchQuery;
            if (SearchQueryChanged.HasDelegate)
            {
                await InvokeAsync(async () => await SearchQueryChanged.InvokeAsync(_searchQuery));
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        _context.OnStateChanged -= HandleContextStateChanged;
        browserDisposed = true;
        await browserGate.WaitAsync();
        try
        {
            if (browserController != null) { await browserController.InvokeVoidAsync("dispose"); await browserController.DisposeAsync(); }
            if (browserModule != null) await browserModule.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException) { }
        finally { browserGate.Release(); }
    }
}
