@typeparam TValue
@namespace NeoUI.Blazor.Primitives
@implements IDisposable

@* SelectItem primitive - headless selectable option *@
@if (_context != null)
{
    <div id="@ItemId"
         role="option"
         aria-disabled="@Disabled.ToString().ToLowerInvariant()"
         aria-selected="@(_context.Browser.Enabled ? null : IsSelected.ToString().ToLower())"
         data-neo-text="@TextValue"
         data-state="@(_context.Browser.Enabled ? null : (IsSelected ? "checked" : "unchecked"))"
         data-focused="@(!_context.Browser.Enabled && IsFocused ? "true" : null)"
         data-disabled="@(Disabled ? "true" : null)"
         @onclick="@(_context.Browser.Enabled ? default(EventCallback<MouseEventArgs>) : EventCallback.Factory.Create<MouseEventArgs>(this, HandleClick))"
         @onclick:stopPropagation="true"
         @onmouseenter="@(_context.Browser.Enabled ? default(EventCallback<MouseEventArgs>) : EventCallback.Factory.Create<MouseEventArgs>(this, HandleMouseEnter))"
         @attributes="AdditionalAttributes">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter]
    private SelectContext<TValue>? _context { get; set; }

    private int _itemIndex = -1;
    private readonly string browserItemId = $"neo-option-{Guid.NewGuid():N}";

    protected override void OnParametersSet()
    {
        if (_context?.Browser.Enabled == true)
        {
            var item = (Value, Disabled, TextValue ?? Value?.ToString());
            if (!_context.BrowserItems.TryGetValue(browserItemId, out var previous) || !previous.Equals(item))
            {
                var missingSelection = _context.BrowserSelectedId == null;
                _context.BrowserItems[browserItemId] = item;
                if (missingSelection && _context.BrowserSelectedId != null) _context.Browser.ValueVersion++;
                _context.RefreshBrowserValue();
            }
        }
    }


    /// <summary>
    /// The value this item represents.
    /// </summary>
    [Parameter, EditorRequired]
    public TValue? Value { get; set; }

    /// <summary>
    /// Optional display text. If not provided, ChildContent is used.
    /// </summary>
    [Parameter]
    public string? TextValue { get; set; }

    /// <summary>
    /// Whether this item is disabled and cannot be selected.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>
    /// Content to render for this item.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional attributes to be applied to the item element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    private string ItemId => _context?.Browser.Enabled == true ? browserItemId : _context != null ? $"{_context.ContentId}-item-{_itemIndex}" : "";

    private bool IsSelected
    {
        get
        {
            if (_context == null) return false;

            if (_context.Value == null && Value == null)
                return true;

            return EqualityComparer<TValue?>.Default.Equals(_context.Value, Value);
        }
    }

    private bool IsFocused => _context != null && _context.FocusedIndex == _itemIndex;

    protected override void OnInitialized()
    {
        if (_context == null || _context.Browser.Enabled) return;

        // Get display text - either from TextValue parameter or fallback to Value string
        var displayText = TextValue ?? Value?.ToString();

        // Register this item with the context for keyboard navigation
        _itemIndex = _context.RegisterItem(Value, Disabled, displayText);

        // Subscribe to state changes to update focus
        _context.OnStateChanged += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        StateHasChanged();
    }

    private void HandleClick()
    {
        if (_context == null || Disabled || _context.Disabled) return;

        // Get display text - either from TextValue parameter or render ChildContent to string
        var displayText = TextValue ?? Value?.ToString();

        _context.SelectValue(Value, displayText);
    }

    private void HandleMouseEnter()
    {
        if (_context == null) return;

        // Update focused index on mouse hover for better UX
        if (!Disabled && !_context.Disabled)
        {
            _context.SetFocusedIndex(_itemIndex);
        }
    }

    public void Dispose()
    {
        if (_context != null)
        {
            _context.BrowserItems.Remove(browserItemId);
            _context.OnStateChanged -= HandleStateChanged;
        }
        // Note: We don't unregister the item here as it could mess up indices
        // The context will be recreated when the select is reopened
    }
}
