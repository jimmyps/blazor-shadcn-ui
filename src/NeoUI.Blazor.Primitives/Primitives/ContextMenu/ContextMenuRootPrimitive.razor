@inject Microsoft.Extensions.Options.IOptions<InteractionOptions> InteractionDefaults
@namespace NeoUI.Blazor.Primitives
@implements IDisposable

@* ContextMenuRoot primitive component - headless context menu behavior *@
<CascadingValue Value="family" IsFixed="true">
<CascadingValue Value="@_context" IsFixed="false">
    @if (family.Enabled)
    {
        <DropdownMenuPrimitive InteractionMode="NeoUI.Blazor.Primitives.InteractionMode.Browser" Open="@(programmaticOpen ?? Open ?? _context.IsOpen)" OpenChanged="@(OpenChanged.HasDelegate || OnOpen.HasDelegate || OnClose.HasDelegate ? EventCallback.Factory.Create<bool>(this, ReportBrowserOpen) : default)" InteractionRevision="@(InteractionRevision + localRevision)">
            @ChildContent
        </DropdownMenuPrimitive>
    }
    else { @ChildContent }
</CascadingValue>

</CascadingValue>

@code {
    private bool? programmaticOpen, lastOpen;
    private long lastRevision;
    private long localRevision;
    private readonly BrowserMenuFamily family = new();
    /// <summary>Overrides scoped and application interaction policy.</summary>
    [Parameter] public InteractionMode? InteractionMode { get; set; }
    /// <summary>Increment to issue an authoritative browser reset.</summary>
    [Parameter] public long InteractionRevision { get; set; }
    [CascadingParameter] private InteractionPolicy? InteractionPolicy { get; set; }
    private InteractionMode EffectiveMode => InteractionMode ?? InteractionPolicy?.Mode ?? InteractionDefaults.Value.DefaultMode;
    private readonly BrowserFloatingState mode = new();

    private readonly ContextMenuContext _context = new();

    /// <summary>
    /// The child content to render within the context menu context.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Controls whether the context menu is open (controlled mode).
    /// </summary>
    [Parameter]
    public bool? Open { get; set; }

    /// <summary>
    /// Event callback invoked when the open state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OpenChanged { get; set; }

    /// <summary>
    /// Event callback invoked when the context menu opens.
    /// </summary>
    [Parameter]
    public EventCallback<(double X, double Y)> OnOpen { get; set; }

    /// <summary>
    /// Event callback invoked when the context menu closes.
    /// </summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// X coordinate to open the context menu at. Used when <see cref="Open"/> is set programmatically
    /// (i.e. without a <c>ContextMenuTrigger</c> right-click gesture).
    /// </summary>
    [Parameter]
    public double X { get; set; }

    /// <summary>
    /// Y coordinate to open the context menu at. Used when <see cref="Open"/> is set programmatically.
    /// </summary>
    [Parameter]
    public double Y { get; set; }

    protected override void OnInitialized()
    {
        mode.Sync(EffectiveMode, null, false, 0);
        family.Enabled = mode.Enabled;

        if (Open.HasValue && Open.Value)
        {
            _context.Open(0, 0);
        }

        _context.OnStateChanged += HandleContextStateChanged;
    }

    protected override void OnParametersSet()
    {
        mode.Sync(EffectiveMode, null, false, 0);
        family.ContextPosition = OnOpen.HasDelegate ? (x, y) => { _context.State.X = x; _context.State.Y = y; } : null;
        if (lastOpen != Open || lastRevision != InteractionRevision) programmaticOpen = null;
        lastOpen = Open; lastRevision = InteractionRevision;
        if (Open.HasValue && _context.IsOpen != Open.Value)
        {
            if (Open.Value)
            {
                _context.Open(X != 0 || Y != 0 ? X : _context.X, X != 0 || Y != 0 ? Y : _context.Y);
            }
            else
            {
                _context.Close();
            }
        }
        else if (Open.HasValue && Open.Value && _context.IsOpen && (X > 0 || Y > 0) && (X != _context.X || Y != _context.Y))
        {
            // Menu is already open but coordinates changed (e.g. right-click on a different row).
            // Reposition the menu at the new location without toggling open state.
            _context.Open(X, Y);
        }
    }

    private async Task ReportBrowserOpen(bool open)
    {
        await OpenChanged.InvokeAsync(open);
        if (open) await OnOpen.InvokeAsync((_context.X, _context.Y));
        else await OnClose.InvokeAsync();
    }

    private async void HandleContextStateChanged()
    {
        if (family.Enabled) { StateHasChanged(); return; }
        if (OpenChanged.HasDelegate)
        {
            await OpenChanged.InvokeAsync(_context.IsOpen);
        }

        if (_context.IsOpen && OnOpen.HasDelegate)
        {
            await OnOpen.InvokeAsync((_context.X, _context.Y));
        }
        else if (!_context.IsOpen && OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync();
        }
    }

    /// <summary>Opens the context menu at the specified viewport coordinates without requiring a parameter round-trip.</summary>
    public void OpenAt(double x, double y)
    {
        if (family.Enabled) { programmaticOpen = true; _context.State.X = x; _context.State.Y = y; localRevision++; StateHasChanged(); }
        else _context.Open(x, y);
    }

    public void Dispose()
    {
        _context.OnStateChanged -= HandleContextStateChanged;
    }
}
