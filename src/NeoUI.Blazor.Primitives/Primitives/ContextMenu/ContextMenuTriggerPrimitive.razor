@namespace NeoUI.Blazor.Primitives

@* ContextMenuTriggerPrimitive - element that triggers the context menu on right-click *@
@if (Family?.Enabled == true)
{
    <div id="@BrowserMenu!.TriggerId" tabindex="0" aria-haspopup="menu" aria-controls="@BrowserMenu.ContentId"
         aria-disabled="@Disabled.ToString().ToLowerInvariant()" @attributes="AdditionalAttributes">@ChildContent</div>
}
else
{
<div @oncontextmenu="HandleContextMenu"
     @oncontextmenu:preventDefault
     @attributes="AdditionalAttributes"
     id="@Context.TriggerId"
     data-state="@(Context.IsOpen ? "open" : "closed")">
    @ChildContent
</div>

}
@code {
    [CascadingParameter] private BrowserMenuFamily? Family { get; set; }
    [CascadingParameter] private DropdownMenuContext? BrowserMenu { get; set; }
    [CascadingParameter]
    private ContextMenuContext Context { get; set; } = null!;

    /// <summary>
    /// The child content that triggers the context menu.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Whether the trigger is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; } = false;

    /// <summary>
    /// Additional attributes to apply to the trigger element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnInitialized()
    {
        if (Context == null)
        {
            throw new InvalidOperationException(
                "ContextMenuTriggerPrimitive must be used within a ContextMenuRootPrimitive component.");
        }
    }

    private void HandleContextMenu(MouseEventArgs args)
    {
        if (Disabled) return;

        Context.Open(args.ClientX, args.ClientY);
    }
}
