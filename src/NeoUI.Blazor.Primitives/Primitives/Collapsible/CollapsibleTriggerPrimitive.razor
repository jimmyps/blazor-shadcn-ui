@namespace NeoUI.Blazor.Primitives
@if (AsChild)
{
    @* When AsChild is true, pass trigger context to child for it to handle *@
    <CascadingValue Value="TriggerContext" Name="TriggerContext">
        @ChildContent
    </CascadingValue>
}
else
{
    <button type="button" id="@(Context?.BrowserInteraction == true ? Context.TriggerId : null)" aria-controls="@(Context?.BrowserInteraction == true ? Context.ContentId : null)"
            data-state="@(Context?.BrowserInteraction == true ? null : (Context?.Open ?? false ? "open" : "closed"))"
            aria-expanded="@(Context?.BrowserInteraction == true ? null : (Context?.Open ?? false).ToString().ToLowerInvariant())"
            disabled="@(Context?.Disabled ?? false)"
            @onclick="@(Context?.BrowserInteraction == true ? default(EventCallback<MouseEventArgs>) : EventCallback.Factory.Create<MouseEventArgs>(this, HandleClick))"
            @onkeydown="@(Context?.BrowserInteraction == true ? default(EventCallback<KeyboardEventArgs>) : EventCallback.Factory.Create<KeyboardEventArgs>(this, HandleKeyDown))"
            @attributes="AdditionalAttributes">
        @ChildContent
    </button>
}
