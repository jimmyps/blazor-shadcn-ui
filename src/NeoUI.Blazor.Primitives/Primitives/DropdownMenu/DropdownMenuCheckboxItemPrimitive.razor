@namespace NeoUI.Blazor.Primitives
@implements IDropdownMenuItem
@implements IDisposable

<div @ref="_itemRef"
     id="@browserSelection.Id"
     data-neo-check-key="@(Context.Browser.Enabled ? browserSelection.Id : null)"
     data-neo-check-value="true"
     data-neo-check-accepted="@(Context.Browser.Enabled ? browserSelection.Value : null)"
     data-neo-check-version="@(Context.Browser.Enabled ? browserSelection.Version : null)"
     data-neo-close-on-select="@CloseOnSelect.ToString().ToLowerInvariant()"
     role="menuitemcheckbox"
     tabindex="-1"
     aria-checked="@Checked.ToString().ToLower()"
     aria-disabled="@Disabled.ToString().ToLower()"
     data-disabled="@(Disabled ? "true" : null)"
     data-state="@(Checked ? "checked" : "unchecked")"
     @onclick="@(Context.Browser.Enabled ? default : EventCallback.Factory.Create<MouseEventArgs>(this, HandleClick))"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [CascadingParameter]
    private DropdownMenuContext Context { get; set; } = null!;

    [CascadingParameter]
    private DropdownMenuContentPrimitive? ContentContext { get; set; }

    private ElementReference _itemRef;

    /// <summary>
    /// The content to display inside the checkbox item.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional attributes to apply to the checkbox item element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Whether the checkbox item is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; } = false;

    /// <summary>
    /// Whether the checkbox is checked.
    /// </summary>
    [Parameter]
    public bool Checked { get; set; }

    /// <summary>
    /// Event callback invoked when the checked state changes.
    /// </summary>
    [Parameter]
    public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>
    /// Event callback invoked when the checkbox checked state changes.
    /// Receives the new checked state as a parameter.
    /// </summary>
    [Parameter]
    public EventCallback<bool> OnCheckedChange { get; set; }

    /// <summary>
    /// Whether to close the dropdown menu when this item is selected.
    /// Default is false for checkbox items.
    /// </summary>
    [Parameter]
    public bool CloseOnSelect { get; set; } = false;

    private readonly BrowserMenuSelection browserSelection = new();
    /// <summary>Increment to authoritatively reset the checked value, even if unchanged.</summary>
    [Parameter] public long InteractionRevision { get; set; }

    protected override void OnParametersSet()
    {
        if (Context.Browser.Enabled) browserSelection.Sync(Checked.ToString().ToLowerInvariant(), Context.Browser.ValueVersion, InteractionRevision);
    }

    protected override void OnInitialized()
    {
        if (Context == null)
        {
            throw new InvalidOperationException(
                "DropdownMenuCheckboxItemPrimitive must be used within a DropdownMenuPrimitive component. " +
                "Ensure DropdownMenuCheckboxItemPrimitive is a child of a DropdownMenuPrimitive component.");
        }

        if (Context.Browser.Enabled)
        {
            browserSelection.Commit = async proposed =>
            {
                if (Disabled) return browserSelection.Value;
                var value = proposed == "true";
                if (CheckedChanged.HasDelegate) await CheckedChanged.InvokeAsync(value);
                else Checked = value;
                await OnCheckedChange.InvokeAsync(value);
                return Checked.ToString().ToLowerInvariant();
            };
            Context.BrowserSelections.Add(browserSelection.Id, browserSelection);
        }
        // Register this item with the content for keyboard navigation
        ContentContext?.RegisterMenuItem(this);
    }

    private async Task HandleClick(MouseEventArgs args)
    {
        if (Disabled) return;

        // Toggle checked state
        Checked = !Checked;

        // Invoke callbacks
        await CheckedChanged.InvokeAsync(Checked);
        if (OnCheckedChange.HasDelegate)
        {
            await OnCheckedChange.InvokeAsync(Checked);
        }

        // Close the dropdown menu if configured
        if (CloseOnSelect && Context != null)
        {
            Context.Close();
        }
    }

    // IDropdownMenuItem implementation
    public async Task FocusAsync()
    {
        try
        {
            await _itemRef.FocusAsync();
        }
        catch
        {
            // Ignore focus errors (element might not be mounted yet)
        }
    }

    public async Task ClickAsync()
    {
        if (Disabled) return;
        await HandleClick(new MouseEventArgs());
    }

    public void Dispose()
    {
        Context?.BrowserSelections.Remove(browserSelection.Id);
        // Unregister this item when disposed
        ContentContext?.UnregisterMenuItem(this);
    }
}
