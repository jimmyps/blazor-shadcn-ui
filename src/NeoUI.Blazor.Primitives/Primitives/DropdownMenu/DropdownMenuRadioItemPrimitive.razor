@namespace NeoUI.Blazor.Primitives
@typeparam TValue
@implements IDropdownMenuItem
@implements IDisposable

@* DropdownMenuRadioItemPrimitive - a radio item within a radio group *@
<div @ref="_itemRef"
     data-neo-check-key="@(MenuContext.Browser.Enabled ? RadioGroupContext?.BrowserSelection.Id : null)"
     data-neo-check-value="@browserValue"
     data-neo-check-accepted="@(MenuContext.Browser.Enabled ? RadioGroupContext?.BrowserSelection.Value : null)"
     data-neo-check-version="@(MenuContext.Browser.Enabled ? RadioGroupContext?.BrowserSelection.Version : null)"
     data-neo-close-on-select="@CloseOnSelect.ToString().ToLowerInvariant()"
     role="menuitemradio"
     tabindex="-1"
     aria-checked="@IsSelected.ToString().ToLower()"
     aria-disabled="@Disabled.ToString().ToLower()"
     @onclick="@(MenuContext.Browser.Enabled ? default : EventCallback.Factory.Create<MouseEventArgs>(this, HandleClick))"
     data-state="@(IsSelected ? "checked" : "unchecked")"
     data-disabled="@(Disabled ? "true" : null)"
     @attributes="AdditionalAttributes">
    @ChildContent
</div>

@code {
    [CascadingParameter]
    private DropdownMenuContext MenuContext { get; set; } = null!;

    [CascadingParameter]
    private DropdownMenuRadioGroupContext<TValue>? RadioGroupContext { get; set; }

    [CascadingParameter]
    private DropdownMenuContentPrimitive? ContentContext { get; set; }

    private ElementReference _itemRef;

    /// <summary>
    /// The content to display inside the radio item.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional attributes to apply to the radio item element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// Whether the radio item is disabled.
    /// </summary>
    [Parameter]
    public bool Disabled { get; set; } = false;

    /// <summary>
    /// The value associated with this radio item.
    /// </summary>
    [Parameter]
    public TValue? Value { get; set; }

    /// <summary>
    /// Whether to close the dropdown menu when this item is selected.
    /// Default is true for radio items.
    /// </summary>
    [Parameter]
    public bool CloseOnSelect { get; set; } = true;

    private bool IsSelected => RadioGroupContext != null &&
                               EqualityComparer<TValue?>.Default.Equals(RadioGroupContext.Value, Value);

    private readonly string browserValue = $"menu-radio-{Guid.NewGuid():N}";
    protected override void OnParametersSet()
    {
        if (MenuContext.Browser.Enabled && RadioGroupContext != null) RadioGroupContext.BrowserItems[browserValue] = (Value, Disabled);
    }
    protected override void OnInitialized()
    {
        if (MenuContext == null)
        {
            throw new InvalidOperationException(
                "DropdownMenuRadioItemPrimitive must be used within a DropdownMenuPrimitive component.");
        }

        if (RadioGroupContext == null)
        {
            throw new InvalidOperationException(
                "DropdownMenuRadioItemPrimitive must be used within a DropdownMenuRadioGroupPrimitive component.");
        }

        // Register this item with the content for keyboard navigation
        ContentContext?.RegisterMenuItem(this);
    }

    private async Task HandleClick(MouseEventArgs args)
    {
        if (Disabled) return;

        // Select this item
        if (RadioGroupContext?.SelectValue != null)
        {
            await RadioGroupContext.SelectValue(Value);
        }

        // Close the dropdown menu if configured
        if (CloseOnSelect && MenuContext != null)
        {
            MenuContext.Close();
        }
    }

    // IDropdownMenuItem implementation
    public async Task FocusAsync()
    {
        try
        {
            await _itemRef.FocusAsync();
        }
        catch
        {
            // Ignore focus errors
        }
    }

    public async Task ClickAsync()
    {
        if (Disabled) return;
        await HandleClick(new MouseEventArgs());
    }

    public void Dispose()
    {
        RadioGroupContext?.BrowserItems.Remove(browserValue);
        ContentContext?.UnregisterMenuItem(this);
    }
}
