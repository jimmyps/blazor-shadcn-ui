@namespace NeoUI.Blazor.Primitives
@typeparam TValue
@implements IDisposable

@* DropdownMenuRadioGroupPrimitive - a group of radio items where only one can be selected *@
<CascadingValue Value="@_context" IsFixed="false">
    <div role="group" @attributes="AdditionalAttributes">
        @ChildContent
    </div>
</CascadingValue>

@code {
    private readonly DropdownMenuRadioGroupContext<TValue> _context = new();

    [CascadingParameter]
    private DropdownMenuContext MenuContext { get; set; } = null!;

    /// <summary>
    /// The content to render inside the radio group.
    /// Typically contains DropdownMenuRadioItemPrimitive components.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Additional attributes to apply to the radio group element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    /// <summary>
    /// The currently selected value.
    /// </summary>
    [Parameter]
    public TValue? Value { get; set; }

    /// <summary>
    /// Event callback invoked when the selected value changes (for two-way binding).
    /// </summary>
    [Parameter]
    public EventCallback<TValue?> ValueChanged { get; set; }

    /// <summary>
    /// Event callback invoked when the selection changes.
    /// </summary>
    [Parameter]
    public EventCallback<TValue?> OnValueChange { get; set; }

    protected override void OnInitialized()
    {
        if (MenuContext == null)
        {
            throw new InvalidOperationException(
                "DropdownMenuRadioGroupPrimitive must be used within a DropdownMenuPrimitive component.");
        }

        if (MenuContext.Browser.Enabled)
        {
            var selection = _context.BrowserSelection;
            selection.Commit = async proposed =>
            {
                if (proposed == null || !_context.BrowserItems.TryGetValue(proposed, out var item) || item.Disabled) return selection.Value;
                if (ValueChanged.HasDelegate) await ValueChanged.InvokeAsync(item.Value);
                else Value = item.Value;
                await OnValueChange.InvokeAsync(item.Value);
                _context.Value = Value;
                return GetBrowserValue();
            };
            MenuContext.BrowserSelections.Add(selection.Id, selection);
        }
        _context.Value = Value;
        _context.SelectValue = HandleSelectValue;
    }

    /// <summary>Increment to authoritatively reset the radio selection, even if unchanged.</summary>
    [Parameter] public long InteractionRevision { get; set; }
    public void Dispose() => MenuContext?.BrowserSelections.Remove(_context.BrowserSelection.Id);

    protected override void OnParametersSet()
    {
        if (MenuContext.Browser.Enabled) _context.BrowserSelection.Sync(GetBrowserValue(), MenuContext.Browser.ValueVersion, InteractionRevision);
        _context.Value = Value;
    }

    private string? GetBrowserValue() => _context.BrowserItems
        .FirstOrDefault(item => EqualityComparer<TValue?>.Default.Equals(item.Value.Value, Value)).Key;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!MenuContext.Browser.Enabled) return;
        // Items register after the group receives its parameters. Reconcile opaque IDs
        // once their live typed values are known, including declarative item changes.
        var before = _context.BrowserSelection.Version;
        _context.BrowserSelection.Sync(GetBrowserValue(), MenuContext.Browser.ValueVersion, InteractionRevision);
        if (before != _context.BrowserSelection.Version) StateHasChanged();
    }

    private async Task HandleSelectValue(TValue? value)
    {
        Value = value;
        _context.Value = value;

        await ValueChanged.InvokeAsync(value);
        if (OnValueChange.HasDelegate)
        {
            await OnValueChange.InvokeAsync(value);
        }
    }
}
