@namespace NeoUI.Blazor.Primitives

@* AccordionTrigger primitive - clickable trigger button for accordion item *@
<h3 id="@Item.HeaderId">
    <button id="@Item.TriggerId"
            type="button"
            data-neo-state-value="@(Item.Context.BrowserInteraction ? Item.Value : null)"
            class="@Class"
            aria-expanded="@(Item.Context.BrowserInteraction ? null : _ariaExpanded)"
            aria-controls="@Item.ContentId"
            data-state="@(Item.Context.BrowserInteraction ? null : (Item.IsOpen ? "open" : "closed"))"
            disabled="@Item.Disabled"
            @onclick="@(Item.Context.BrowserInteraction ? default(EventCallback<MouseEventArgs>) : EventCallback.Factory.Create<MouseEventArgs>(this, HandleClick))"
            @onkeydown="@(Item.Context.BrowserInteraction ? default(EventCallback<KeyboardEventArgs>) : EventCallback.Factory.Create<KeyboardEventArgs>(this, HandleKeyDown))"
            @attributes="AdditionalAttributes">
        @ChildContent
    </button>
</h3>

@code {
    private string _ariaExpanded => Item.IsOpen ? "true" : "false";

    /// <summary>
    /// Cascading parameter to receive the parent accordion item.
    /// </summary>
    [CascadingParameter]
    public AccordionItemPrimitive Item { get; set; } = null!;

    /// <summary>
    /// The child content to render within the trigger button.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// CSS classes to apply to the trigger button element.
    /// </summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>
    /// Additional attributes to apply to the trigger button element.
    /// </summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override void OnInitialized()
    {
        if (Item == null)
        {
            throw new InvalidOperationException("AccordionTriggerPrimitive must be used within an AccordionItemPrimitive component.");
        }
    }

    private void HandleClick()
    {
        if (!Item.Disabled)
        {
            Item.Toggle();
        }
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (Item.Disabled) return;

        // Space and Enter activate the trigger
        if (e.Key == " " || e.Key == "Enter")
        {
            Item.Toggle();
        }
    }
}
